{
  "name": "wp-hardening-toolkit/wp-hardening-toolkit",
  "description": "A modular, opt-in WordPress security hardening plugin.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^1.12",
    "php-stubs/wordpress-stubs": "^6.4",
    "phpunit/phpunit": "^9.6",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "WPHardeningToolkit\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WPHardeningToolkit\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "find . -type f -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
    "phpcs": "phpcs",
    "phpstan": "phpstan analyse --debug --no-progress --memory-limit=512M",
    "test": "phpunit",
    "check": [
      "@lint",
      "@phpcs",
      "@phpstan",
      "@test"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  }
}
