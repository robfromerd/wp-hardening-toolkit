parameters:
    level: 8
    parallel:
        maximumNumberOfProcesses: 1
    paths:
        - includes
        - wp-hardening-toolkit.php
        - uninstall.php
    bootstrapFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    scanFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    excludePaths:
        analyse:
            - vendor
